# =============================================================================
# HomeCube · RT-1 Real-Stack E2E Test Environment
#
# This file configures services to connect to the temporary hc_rt1_e2e database
# instead of the default homecube dev database.
#
# Usage: 
#   1. Set up temp database: sh deploy/scripts/setup-rt1-db.sh up
#   2. Run services with this env: set -a; source deploy/env.local.rt1; set +a
#   3. Run bill-create → pay → revoke chain
#   4. Clean up: sh deploy/scripts/setup-rt1-db.sh down
#
# All values are derived from the main env.local, but DSNs point to hc_rt1_e2e.
# =============================================================================

# ---- Temporary Database Configuration ----------------------------------------
# Point to the isolated test database instead of the dev database
RT1_DB_NAME="hc_rt1_e2e"

# HOMEOS DSN pointing to temporary database (host=127.0.0.1 for containerized postgres)
HOMEOS_DSN="host=127.0.0.1 port=5432 user=hc_homeos password=test123 dbname=hc_rt1_e2e search_path=homeos"

# FINANCE DSN pointing to temporary database
FINANCE_DSN="host=127.0.0.1 port=5432 user=hc_finance password=test123 dbname=hc_rt1_e2e search_path=finance"

# Container-side DSNs (for docker-compose usage)
HOMEOS_DSN_CONTAINER="host=postgres16 port=5432 user=hc_homeos password=test123 dbname=hc_rt1_e2e search_path=homeos"
FINANCE_DSN_CONTAINER="host=postgres16 port=5432 user=hc_finance password=test123 dbname=hc_rt1_e2e search_path=finance"

# ---- NATS / JetStream Address ------------------------------------------------
# Same as dev environment (NATS is shared, isolation is at the database level)
NATS_URL="nats://127.0.0.1:4222"
NATS_URL_CONTAINER="nats://nats:4222"

# ---- Service Listen Addresses ------------------------------------------------
HOMEOS_ADDR=":8080"
FINANCE_ADDR=":8081"

# ---- Nginx Configuration -----------------------------------------------------
NGINX_HTTP_PORT="80"
HOMEOS_UPSTREAM="host.docker.internal:8080"
FINANCE_UPSTREAM="host.docker.internal:8081"

# ---- Upload Directory --------------------------------------------------------
UPLOAD_DIR="./uploads/{family_id}"

# ---- PostgreSQL Base Configuration -------------------------------------------
POSTGRES_DB="homecube"
POSTGRES_PASSWORD="CHANGE_ME"

# ---- JWKS URL ----------------------------------------------------------------
FINANCE_JWKS_URL="http://CHANGE_ME/api/homeos/.well-known/jwks.json"

# ---- Backup and Soak Report Paths --------------------------------------------
BACKUP_DIR="deploy/data/backups"
SOAK_REPORT="deploy/data/soak/report.json"
