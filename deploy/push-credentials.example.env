# Push notification credentials (required for P2 commercial launch)
# Copy this file to push-credentials.env and fill in real values before P2 launch
# DO NOT commit push-credentials.env to version control

JPUSH_APP_KEY=your_jpush_app_key_here
JPUSH_MASTER_SECRET=your_jpush_master_secret_here

GETUI_APP_KEY=your_getui_app_key_here
GETUI_MASTER_SECRET=your_getui_master_secret_here

UMENG_APP_KEY=your_umeng_app_key_here
UMENG_MASTER_SECRET=your_umeng_master_secret_here
