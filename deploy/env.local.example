# =============================================================================
# HomeCube · env 样例
#
# 文件位置的权威源：docs/p1-tech-plan.md §十三「本地：make up 起全栈，make dev-{code}
# 把某服务跑出容器外调试（dev-homeos / dev-finance），端口与 env 在
# deploy/env.local.example」。
#
# 用法：cp deploy/env.local.example deploy/env.local，再把所有 CHANGE_ME 换掉。
#       deploy/env.local 已被根 .gitignore 忽略；origin 是 PUBLIC 仓库（PRD 22.4、
#       p1-dev-brief §3），任何真实凭据、本机绝对路径都不得提交。
#
# 两条消费路径（因此格式有约束）：
#   1) docker compose --env-file（§10.1 的 up / backup / restore / rollback 配方）
#   2) make dev-{code} 用 shell 的 set -a + source 读入（§十三，服务跑在容器外）
#   => 每个键写成 "..." 单行带引号形式，值内不含换行；含空格的值必须加引号（DSN 形态）。
#
# 纪律（PRD 22.5 五道门禁、22.2 第 7 条：登记面不得私自扩张）：
#   本文件只写文档里显式出现过的配置项，每行都注明出处条款；
#   文档没写的键一个都不发明。P1 不引 Redis、不引独立搜索集群（PRD 22.1 第 2 条、
#   tech plan §六 中文检索定版 C 行），所以这里没有它们的开关；
#   面开关不进 env（tech plan §4.2：Family.feature_flags 只承载非面开关，
#   面集合的权威源是 homeos_family_module，定版 O 行）。
#
# 「文档没写的键一个都不发明」与 §十三 的冲突由本文件自己承担：§十三 把「端口」这件事
#   交付给本文件，而三份文档里没有任何一处写过端口号。所以端口类的键是**工程必要的扩张**，
#   不是随手加的。S1-D-a 新增/改形的键共七类，逐条写着出处与非加不可的理由：
#     POSTGRES_DB、POSTGRES_PASSWORD                 （官方 postgres 镜像的启动前置件）
#     NGINX_HTTP_PORT                                （compose 的宿主端口映射）
#     HOMEOS_ADDR、FINANCE_ADDR                      （obs 已实现的 {CODE}_ADDR 口，补登记）
#     HOMEOS_UPSTREAM、FINANCE_UPSTREAM              （nginx 的上游地址，见 deploy/nginx.conf）
#     HOMEOS_DSN、FINANCE_DSN 加 host=/port= 两段     （容器外进程连容器里的库）
#     NATS_URL 填实 host:port                        （同上，原来是 CHANGE_ME:CHANGE_ME）
#   这七类都要由主 agent 走回写卡登记；值全部是占位符或通用默认，无真实凭据、无本机绝对路径。
# =============================================================================

# ---- 每服务一串 DSN：账号即边界 ----------------------------------------------
# 出处：tech plan §2.1（原文示例 user=hc_finance dbname=homecube search_path=finance，
#       并给出 CREATE SCHEMA / CREATE ROLE hc_finance LOGIN PASSWORD '…' / GRANT USAGE /
#       REVOKE ALL ON SCHEMA public 五条）；§1.3 命名表「schema」行：连接串
#       search_path={code}、账号名 hc_{code}；PRD 22.2 第 2 条、卷首第 12 项。
# 当期只有两个 schema（homeos / finance），其余五个 schema 随各面出生期新建（§2.1、PRD 22.4）。
# 跨 schema 在权限层就做不到，不靠代码约定；建 schema 与建账号只发生在 make up 与
# 迁移容器里，不由服务进程在运行期自触发（§2.1 末条）——因此这里只有 DSN，没有建库口令。
# password= 的值出自 §2.1 的 CREATE ROLE ... PASSWORD，真实值不落仓，一律占位符 CHANGE_ME。
#
# host= / port= 段（S1-D-a 回填，§十三把「端口」这件事交付给本文件）：
#   形态仍是 §2.1 的关键字/值串，obs.ValidateDSN 只断言 user / search_path / dbname /
#   password 四段（server/packages/obs/config.go），host/port 是透传给 libpq 的额外段，
#   因此加它们不放宽任何断言。
#   值是 **宿主回环**：这两串 DSN 现在只被容器外的 make dev-{code} 消费（§十三），
#   库在 deploy/docker-compose.yml 的 postgres16 服务里、把 5432 只绑到 127.0.0.1。
#   端口两处必须一致：compose 的 "127.0.0.1:5432:5432" 与本串的 port=5432。
#   D-b 的服务容器形态需要另一个 host（compose 服务名 postgres16，§10.1 原文登记的名字），
#   那一份 env 的落点属 D-b，与本卡「容器外调试」这一份并存而不是替换。
#   hc_homeos / hc_finance 两账号与 homeos / finance 两 schema 由 deploy/init-schema.sql
#   在 postgres16 首次初始化时自动创建（docker-entrypoint-initdb.d 机制）。
HOMEOS_DSN="host=127.0.0.1 port=5432 user=hc_homeos password=CHANGE_ME dbname=homecube search_path=homeos"
FINANCE_DSN="host=127.0.0.1 port=5432 user=hc_finance password=CHANGE_ME dbname=homecube search_path=finance"

# ---- 容器内服务连接串（S1-D-b 新增）------------------------------------------
# 出处：§2.1（单集群、每服务一 schema 一账号）、§10.1（compose 内的服务容器形态）。
# 这两串 DSN 专供容器内的 svc-homeos / svc-finance 使用，host 段指向 compose 服务名 postgres16。
# 与上面的宿主调试用 DSN 并存而不是替换：make dev-{code} 用上方的 127.0.0.1 串，
# make up 起容器时用下方的 postgres16 串。
# 口令 CHANGE_ME 与 POSTGRES_PASSWORD 一致（init-schema.sql 建角色时的占位符）。
HOMEOS_DSN_CONTAINER="host=postgres16 port=5432 user=hc_homeos password=CHANGE_ME dbname=homecube search_path=homeos"
FINANCE_DSN_CONTAINER="host=postgres16 port=5432 user=hc_finance password=CHANGE_ME dbname=homecube search_path=finance"

# ---- NATS / JetStream 地址 ---------------------------------------------------
# 出处：tech plan §3.1（JetStream 流规划：HC_HOMEOS=homeos.> / HC_FINANCE=finance.> /
#       HC_ARCHIVE=arch.{code}.> / HC_DL=dl.{code}.>，R=1，未出生面的五条流不建）；
#       §10.1（compose 内的 nats 服务即 JetStream 载体）；PRD 卷首第 12 项、14.5 第 1 项；
#       定版 G 行（总线载体 = NATS JetStream，每服务一条源流 + 归档流 + 死信流）。
# 端口 4222 未在任何文档登记（§十三 把「端口」这件事交付给本文件），故由 S1-D-a 在此定版回填。
# 流的创建与 subject 授权不在本文件配置，属 S2 总线卡（§3.1、§3.2）。
#
# host:port 现值 = 宿主回环 + 4222，理由与上面 DSN 的 host/port 完全一致：
# 本文件管的是容器外调试（§十三），deploy/docker-compose.yml 把 nats 的 4222 只绑到
# 127.0.0.1；两处端口必须一致（compose 的 "127.0.0.1:4222:4222" 与本串的 :4222）。
# D-b 的服务容器形态换成 nats://nats:4222 —— host 段就是 §10.1 登记的 compose 服务名 nats。
NATS_URL="nats://127.0.0.1:4222"

# ---- 容器内 NATS 地址（S1-D-b 新增）------------------------------------------
# 出处：同上，专供容器内服务使用。host 段为 compose 服务名 nats。
NATS_URL_CONTAINER="nats://nats:4222"

# ---- postgres16 容器的初始化：库名与超级用户口令 ----------------------------
# 本卡（S1-D-a）新键，出处与「为什么非加不可」：
#   POSTGRES_DB —— §2.1 的 DSN 示例原文写 dbname=homecube（obs.ValidateDSN 也强制 DSN 里
#     必须有 dbname 段，server/packages/obs/config.go），而官方 postgres 镜像不会自己造这个库。
#   POSTGRES_PASSWORD —— 官方 postgres 镜像没有口令拒绝起容器（除非显式开
#     POSTGRES_HOST_AUTH_METHOD=trust，那等于把超级用户裸奔在端口上，本卡不选）。
#   这个账号是**基础设施载体**的超级用户，不是 §2.1 意义上「每服务一专属账号」的那一类：
#   两服务永远不该拿到它（服务只拿 HOMEOS_DSN / FINANCE_DSN 两串），它的用途到判据 B 为止。
#   真实口令不落仓（origin 是 PUBLIC 仓库，p1-dev-brief §3），一律 CHANGE_ME。
POSTGRES_DB="homecube"
POSTGRES_PASSWORD="CHANGE_ME"

# ---- Nginx 宿主端口与两个上游地址（S1-D-a 新键）------------------------------
# 出处：§1.1（「客户端只对一个 base URL」由 Nginx 前缀反代承载、拓扑图的 nginx :443/80）、
#   §10.1（deploy/ 内 compose 含 nginx）、§十三（端口交付给本文件）。
# 这四个键是「上游地址用变量声明」的那一个源：deploy/nginx.conf 里
#   upstream hc_svc_homeos { server ${HOMEOS_UPSTREAM}; }
# 由官方 nginx 镜像的 envsubst 在容器启动时替换，所以 D-b 把宿主 dev 口换成容器名时
#   只改本文件（HOMEOS_UPSTREAM="svc-homeos:8080"），不改 deploy/nginx.conf。
# NGINX_HTTP_PORT 只在 deploy/docker-compose.yml 的宿主端口映射里用（容器内固定 listen 80）。
#   80 不是文档登记值，是本机可用值；被占就改这里，compose 与浏览器地址跟着走。
# HOMEOS_ADDR / FINANCE_ADDR 是 make dev-{code} 那两个进程的**监听**地址，键名与取值口径来自
#   server/packages/obs/config.go 的 addrEnvKey（S1-C2 已实现但未登记，本键即那条回写）：
#   未设时服务按 registry.Implemented() 登记序派生 :8080 / :8081（obs.defaultListenPortBase）。
#   这里显式写出来，是为了让「端口只在这一个文件里」这条 §十三 的口径成立。
# 两个 *_UPSTREAM 的端口段必须与对应 *_ADDR 的端口段一致（一个是绑、一个是拨）；
#   host 段 host.docker.internal 是容器内看宿主的 Docker Desktop 别名
#   （deploy/docker-compose.yml 的 extra_hosts 让 Linux 引擎也解析同一个名字）。
NGINX_HTTP_PORT="80"
HOMEOS_ADDR=":8080"
FINANCE_ADDR=":8081"
HOMEOS_UPSTREAM="host.docker.internal:8080"
FINANCE_UPSTREAM="host.docker.internal:8081"

# ---- svc-finance 取验签公钥的 JWKS URL ---------------------------------------
# 出处：tech plan §4.1（原文：svc-homeos 是唯一签发方与 RS256 私钥持有者；业务面服务只带
#       公钥，启动时从 /api/homeos/.well-known/jwks.json 拉取并定时轮换）；
#       §15 定版 B 行（RS256 + JWKS 分发）；§十一 S3 行（JWKS 分发的交付位）。
# 路径 /api/homeos/.well-known/jwks.json 是 §4.1 原文登记的；scheme 与 host 段是
# 「单一 base URL，由 Nginx 前缀反代」（§九 首条、PRD 17.7 第 5 条）的内网形态，
# 文档未登记具体 host/端口，故留占位符。
# 私钥不落本文件：业务面服务只带公钥（§4.1），签发方的密钥对属 S3 身份卡与 S1-E 的部署口。
FINANCE_JWKS_URL="http://CHANGE_ME/api/homeos/.well-known/jwks.json"

# ---- 附件（票据）上传目录 ----------------------------------------------------
# 出处：PRD 14.7（原文：附件目录 uploads/{family_id}/；单笔 ≤3 张、单张 ≤5MB、格式限
#       jpg/png/webp，PRD 3.6 的 File 行）；tech plan §8.1 票据附件行（原文：单机磁盘
#       ./uploads/{family_id}/）；PRD 19.3（对象存储为 P1-M1 之后的替代，命中 19.4 触发
#       条件再迁，故 P1 只有本地磁盘这一条）。
# 附件的唯一归属是 homeos 的 File 表，finance_transaction.receipt 只存 file_id（§8.1、
# PRD 16.2）——所以只有 svc-homeos 侧用这个目录，不在 finance 侧另建一份。
# 末段的 {family_id} 由服务写入时插值（14.7 的目录形态本身就是文档登记的形状），不是键名。
UPLOAD_DIR="./uploads/{family_id}"

# ---- 备份落盘目录与长压报告归档件 --------------------------------------------
# 出处：tech plan §10.1 backup 行（原文：当期各 schema 一份 pg_dump -Fd + NATS 流快照 +
#       uploads tar -> 加密落 deploy/data/backups）；§10.1 soak 行与门禁 3 行（原文：报告落
#       deploy/data/soak/report.json，缺该件即判「未测」、按不通过处理）；
#       PRD 21.3（全量每日 1 次 + 每月留存 12 份、RPO ≤15 分钟靠 WAL 连续归档、每季度 1 次
#       真实恢复演练）；§15 定版与 §十一 S14 行。
# deploy/data/ 已在根 .gitignore 内（本地数据不落仓）。
# 注意：§10.1 要求备份包「加密」落盘，但加密凭据的配置项名文档未登记，本文件不发明它 ——
#       该键由 S1-E 的备份脚本提出、经人类定版后再进本文件。
BACKUP_DIR="deploy/data/backups"
SOAK_REPORT="deploy/data/soak/report.json"
