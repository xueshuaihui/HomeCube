{
  "name": "homecube-web",
  "version": "0.0.0",
  "private": true,
  "description": "HomeCube 客户端（uni-app Vue3）：主包 shell + pages/finance 分包。工程骨架口径 = docs/p1-page-structure-navigation.md §2.4、docs/p1-tech-plan.md §九、PRD 17.7。",
  "type": "module",
  "scripts": {
    "gen:domains": "node scripts/gen-domains.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:request": "node --experimental-strip-types --test tests/request.test.ts",
    "predev:h5": "node scripts/gen-domains.mjs && node scripts/check-pages.mjs",
    "dev:h5": "uni",
    "prebuild:h5": "node scripts/gen-domains.mjs && node scripts/check-pages.mjs",
    "build:h5": "uni build",
    "check": "npm run check:pages && npm run check:request"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "typescript": "^5.4.5",
    "vite": "5.2.8"
  }
}
